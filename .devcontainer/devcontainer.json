{
  "name": "Personal Dev Sandbox",
  "image": "lahmanja/devcontainer@sha256:a953bf44772cf97b1cff9ab6d47897aa3cba6cecf6a18194793cbfe0066b9681",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--network=kanban-net"
  ],
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR}/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/root/.claude.json,type=bind",
    "source=${localEnv:HOME}/.zshrc,target=/root/.zshrc.host,type=bind,readonly",
    "source=${localEnv:HOME}/.config/nvim,target=/root/.config/nvim,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,readonly",
    "source=devcontainer-go-mod,target=/home/dev/go/pkg/mod,type=volume",
    "source=devcontainer-cache,target=/root/.cache,type=volume",
    "source=devcontainer-local,target=/root/.local,type=volume",
    "source=devcontainer-npm,target=/root/.npm,type=volume"
  ],
  "containerEnv": {
    "COLORTERM": "truecolor",
    "DEVCONTAINER_FIREWALL": "${localEnv:DEVCONTAINER_FIREWALL}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock"
  },
  "remoteUser": "root",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "mkdir -p /root/.ssh && ssh-add -L > /root/.ssh/id_rsa.pub && sudo --preserve-env=DEVCONTAINER_FIREWALL bash -c 'if [ -f /workspace/.devcontainer/init-firewall.sh ]; then bash /workspace/.devcontainer/init-firewall.sh; else /usr/local/bin/init-firewall.sh; fi'",
  "waitFor": "postStartCommand"
}
