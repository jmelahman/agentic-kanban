{
  "name": "Personal Dev Sandbox",
  "image": "lahmanja/devcontainer@sha256:50bb06f1ac153533dc02e8f8d6028f110bd411628c670b4eafa7fd1402668e91",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--network=kanban-net"
  ],
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR}/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/root/.claude.json,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,readonly",
    "source=devcontainer-go-mod,target=/home/dev/go/pkg/mod,type=volume",
    "source=devcontainer-go-build,target=/root/.cache/go-build,type=volume",
    "source=devcontainer-npm,target=/root/.npm,type=volume"
  ],
  "containerEnv": {
    "COLORTERM": "truecolor",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock"
  },
  "remoteUser": "root",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "mkdir -p /root/.ssh && ssh-add -L > /root/.ssh/id_rsa.pub && sudo bash -c 'if [ -f /workspace/.devcontainer/init-firewall.sh ]; then bash /workspace/.devcontainer/init-firewall.sh; else /usr/local/bin/init-firewall.sh; fi'",
  "waitFor": "postStartCommand"
}
